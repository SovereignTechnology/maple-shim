+// ---------------------------------------------------------------------------
+// Account-login mode (POST /v1/audio/transcriptions)
+//
+// The enclave serves transcription only to a logged-in user JWT on a paid plan
+// and answers API keys with 403 `transcription_app_only` (enclave source,
+// services/opensecret/src/web/openai.rs `transcription_access`). Everything else
+// this proxy forwards authenticates with a per-request API key, so for this one
+// route the caller (maple-shim) instead names an ACCOUNT in headers and the
+// proxy logs in as it, using the SDK's own `login` / `login_with_id`.
+//
+//   X-Maple-Login-Email     a normal account, or
+//   X-Maple-Login-Id        a private/guest account (a UUID, no e-mail)
+//   X-Maple-Login-Password  required with either
+//
+// One attested client + session per account, kept in memory only: the password
+// is held for the life of the process (it is sent on every request anyway) and
+// is never logged, never forwarded upstream, and never part of a Debug impl.
+// A request without these headers behaves exactly as before.
+// ---------------------------------------------------------------------------
+
+const LOGIN_EMAIL_HEADER: &str = "x-maple-login-email";
+const LOGIN_ID_HEADER: &str = "x-maple-login-id";
+const LOGIN_PASSWORD_HEADER: &str = "x-maple-login-password";
+
+/// Maple's public application client id (the one the Maple apps log in with;
+/// maple-agent's release profiles). Override with MAPLE_CLIENT_ID.
+const DEFAULT_LOGIN_CLIENT_ID: Uuid = Uuid::from_u128(0xba5a14b5_d915_47b1_b7b1_afda52bc5fc6);
+
+#[derive(Clone, PartialEq, Eq, Hash)]
+enum LoginIdent {
+    Email(String),
+    Id(Uuid),
+}
+
+/// Deliberately no `Debug`: the password must not be printable by accident.
+#[derive(Clone)]
+struct LoginCredentials {
+    ident: LoginIdent,
+    password: String,
+}
+
+struct SessionEntry {
+    client: Arc<OpenSecretClient>,
+    password: String,
+}
+
+#[derive(Default)]
+struct LoginSessions {
+    slots: Mutex<HashMap<LoginIdent, Arc<Mutex<Option<SessionEntry>>>>>,
+}
+
+impl LoginSessions {
+    async fn slot(&self, ident: &LoginIdent) -> Arc<Mutex<Option<SessionEntry>>> {
+        let mut slots = self.slots.lock().await;
+        Arc::clone(slots.entry(ident.clone()).or_default())
+    }
+
+    /// Drop an account's slot after a failed login, so identifiers that never
+    /// logged in do not pile up: anyone who can reach the proxy can name one.
+    /// The slot stays while it holds a session or another request holds it.
+    /// The caller must have released its own lock on `slot`.
+    async fn forget_if_unused(&self, ident: &LoginIdent, slot: &Arc<Mutex<Option<SessionEntry>>>) {
+        let mut slots = self.slots.lock().await;
+        // Every clone is handed out under `slots`, so with it held the count can
+        // only fall: 2 = the map's own reference plus the caller's.
+        let unused = slots.get(ident).is_some_and(|current| {
+            Arc::ptr_eq(current, slot)
+                && Arc::strong_count(slot) == 2
+                && slot.try_lock().is_ok_and(|inner| inner.is_none())
+        });
+        if unused {
+            slots.remove(ident);
+        }
+    }
+}
+
+fn login_client_id() -> Uuid {
+    std::env::var("MAPLE_CLIENT_ID")
+        .ok()
+        .and_then(|value| Uuid::parse_str(value.trim()).ok())
+        .unwrap_or(DEFAULT_LOGIN_CLIENT_ID)
+}
+
+fn header_text(headers: &HeaderMap, name: &str) -> Result<Option<String>, OpenAIError> {
+    match headers.get(name) {
+        None => Ok(None),
+        Some(value) => value
+            .to_str()
+            .map(|text| Some(text.trim().to_owned()))
+            .map_err(|_| OpenAIError::invalid_request_error(format!("Invalid {name} header"))),
+    }
+}
+
+/// `Ok(None)` when the request names no account (plain API-key behaviour).
+fn extract_login(headers: &HeaderMap) -> Result<Option<LoginCredentials>, OpenAIError> {
+    let email = header_text(headers, LOGIN_EMAIL_HEADER)?.filter(|v| !v.is_empty());
+    let id = header_text(headers, LOGIN_ID_HEADER)?.filter(|v| !v.is_empty());
+    let password = header_text(headers, LOGIN_PASSWORD_HEADER)?.filter(|v| !v.is_empty());
+
+    let ident = match (email, id) {
+        (None, None) => {
+            return match password {
+                None => Ok(None),
+                Some(_) => Err(OpenAIError::invalid_request_error(
+                    "A login password was sent without an account identifier",
+                )),
+            };
+        }
+        (Some(email), None) => LoginIdent::Email(email),
+        (None, Some(id)) => LoginIdent::Id(Uuid::parse_str(&id).map_err(|_| {
+            OpenAIError::invalid_request_error("X-Maple-Login-Id is not a valid UUID")
+        })?),
+        (Some(_), Some(_)) => {
+            return Err(OpenAIError::invalid_request_error(
+                "Send either an e-mail or an account id, not both",
+            ));
+        }
+    };
+    let password = password.ok_or_else(|| {
+        OpenAIError::invalid_request_error("An account identifier was sent without a password")
+    })?;
+    Ok(Some(LoginCredentials { ident, password }))
+}
+
+impl ProxyState {
+    /// The logged-in client for this account, logging in (once) if needed.
+    /// Logins for one account are serialised; different accounts do not block
+    /// each other. A changed password replaces the cached session, but only
+    /// once it has logged in: a wrong password must not evict a working session.
+    async fn login_client(
+        &self,
+        login: &LoginCredentials,
+    ) -> Result<Arc<OpenSecretClient>, ProxyError> {
+        let slot = self.sessions.slot(&login.ident).await;
+        let mut guard = slot.lock().await;
+        if let Some(entry) = guard.as_ref() {
+            if entry.password == login.password {
+                return Ok(Arc::clone(&entry.client));
+            }
+        }
+
+        match self.fresh_login(login).await {
+            Ok(client) => {
+                *guard = Some(SessionEntry {
+                    client: Arc::clone(&client),
+                    password: login.password.clone(),
+                });
+                Ok(client)
+            }
+            Err(error) => {
+                drop(guard);
+                self.sessions.forget_if_unused(&login.ident, &slot).await;
+                Err(error)
+            }
+        }
+    }
+
+    /// A new attested client logged in as this account. Touches no cached state.
+    async fn fresh_login(
+        &self,
+        login: &LoginCredentials,
+    ) -> Result<Arc<OpenSecretClient>, ProxyError> {
+        let request_timeout = self.config.request_timeout();
+        let client = create_shared_client(
+            &self.config.backend_url,
+            self.config.pcr0_environment,
+            request_timeout,
+            self.config.cache_namespace_root.clone(),
+            self.config.client_app,
+        )
+        .await?;
+
+        let client_id = login_client_id();
+        let password = login.password.clone();
+        let attempt = async {
+            match &login.ident {
+                LoginIdent::Email(email) => client.login(email.clone(), password, client_id).await,
+                LoginIdent::Id(id) => client.login_with_id(*id, password, client_id).await,
+            }
+        };
+        match tokio::time::timeout(request_timeout, attempt).await {
+            Err(_) => return Err(timeout_response("Maple account login", request_timeout)),
+            Ok(Err(SdkError::Api { status, .. })) if matches!(status, 400 | 401 | 403 | 404) => {
+                // Do not echo the backend's message: it is about a credential.
+                warn!("Maple account login was rejected (HTTP {status})");
+                return Err((
+                    StatusCode::UNAUTHORIZED,
+                    Json(OpenAIError::authentication_error("Maple account login rejected")),
+                ));
+            }
+            Ok(Err(error)) => return Err(transport_error_response("Maple account login", &error)),
+            Ok(Ok(_)) => {}
+        }
+
+        Ok(Arc::new(client))
+    }
+
+    /// Forget a session the backend stopped accepting -- but only if it is still
+    /// the one that failed, so a concurrent request's fresh login is not discarded.
+    async fn invalidate_login(&self, ident: &LoginIdent, failed: &Arc<OpenSecretClient>) {
+        let slot = self.sessions.slot(ident).await;
+        let mut guard = slot.lock().await;
+        if guard
+            .as_ref()
+            .is_some_and(|entry| Arc::ptr_eq(&entry.client, failed))
+        {
+            *guard = None;
+        }
+    }
+}
+
+/// `POST /v1/audio/transcriptions`: as an account when the request names one,
+/// otherwise exactly [`proxy_openai_request`].
+pub(crate) async fn proxy_transcription_request(
+    State(state): State<Arc<ProxyState>>,
+    OriginalUri(uri): OriginalUri,
+    method: Method,
+    headers: HeaderMap,
+    body: Bytes,
+) -> Result<Response, ProxyError> {
+    let login = extract_login(&headers).map_err(|e| (StatusCode::BAD_REQUEST, Json(e)))?;
+    let Some(login) = login else {
+        return proxy_openai_request(State(state), OriginalUri(uri), method, headers, body).await;
+    };
+
+    debug!("Proxying {} {} as a logged-in account", method, uri.path());
+    let request_timeout = state.config.request_timeout();
+    let request_deadline = tokio::time::sleep(request_timeout).deadline();
+
+    let mut client = state.login_client(&login).await?;
+    // At most one re-login: the SDK refreshes an expiring access token itself,
+    // so a 401 here means the session is gone (or the password changed).
+    for attempt in 0..2 {
+        let request = build_upstream_request(method.clone(), uri.clone(), &headers, body.clone());
+        let outcome = tokio::time::timeout_at(request_deadline, client.send_inference_request(request))
+            .await
+            .map_err(|_| timeout_response("OpenAI-compatible request", request_timeout))?;
+        let session_gone = match &outcome {
+            Ok(response) => response.status() == StatusCode::UNAUTHORIZED,
+            Err(SdkError::Api { status, .. }) => *status == 401,
+            Err(_) => false,
+        };
+        if session_gone && attempt == 0 {
+            warn!("Maple account session was rejected; logging in again");
+            state.invalidate_login(&login.ident, &client).await;
+            client = state.login_client(&login).await?;
+            continue;
+        }
+        let response = outcome
+            .map_err(|error| transport_error_response("OpenSecret inference request", &error))?;
+        return Ok(build_downstream_response(
+            response,
+            state.config.stream_idle_timeout(),
+            request_deadline,
+        ));
+    }
+    Err((
+        StatusCode::BAD_GATEWAY,
+        Json(OpenAIError::server_error(
+            "Failed to communicate securely with the Maple backend",
+        )),
+    ))
+}
+
+#[cfg(test)]
+mod login_tests {
+    use super::*;
+    use axum::http::HeaderValue;
+
+    fn headers(pairs: &[(&'static str, &str)]) -> HeaderMap {
+        let mut map = HeaderMap::new();
+        for (name, value) in pairs {
+            map.insert(*name, HeaderValue::from_str(value).unwrap());
+        }
+        map
+    }
+
+    const ID: &str = "3f2a9c1e-1b4d-4e6f-8a7b-0c1d2e3f4a5b";
+
+    #[test]
+    fn no_login_headers_means_api_key_behaviour() {
+        assert!(extract_login(&headers(&[])).unwrap().is_none());
+        assert!(extract_login(&headers(&[("authorization", "Bearer k")]))
+            .unwrap()
+            .is_none());
+    }
+
+    #[test]
+    fn email_and_private_account_logins_are_recognised() {
+        let by_email = extract_login(&headers(&[
+            (LOGIN_EMAIL_HEADER, "a@b.test"),
+            (LOGIN_PASSWORD_HEADER, "pw"),
+        ]))
+        .unwrap()
+        .unwrap();
+        assert!(by_email.ident == LoginIdent::Email("a@b.test".into()) && by_email.password == "pw");
+
+        let by_id = extract_login(&headers(&[(LOGIN_ID_HEADER, ID), (LOGIN_PASSWORD_HEADER, "pw")]))
+            .unwrap()
+            .unwrap();
+        assert!(by_id.ident == LoginIdent::Id(Uuid::parse_str(ID).unwrap()));
+    }
+
+    #[test]
+    fn malformed_logins_are_rejected_not_guessed() {
+        let bad = |pairs: &[(&'static str, &str)]| extract_login(&headers(pairs)).is_err();
+        assert!(bad(&[(LOGIN_PASSWORD_HEADER, "pw")]), "password alone");
+        assert!(bad(&[(LOGIN_EMAIL_HEADER, "a@b.test")]), "identifier alone");
+        assert!(bad(&[(LOGIN_ID_HEADER, "not-a-uuid"), (LOGIN_PASSWORD_HEADER, "pw")]));
+        assert!(bad(&[
+            (LOGIN_EMAIL_HEADER, "a@b.test"),
+            (LOGIN_ID_HEADER, ID),
+            (LOGIN_PASSWORD_HEADER, "pw"),
+        ]));
+    }
+
+    #[test]
+    fn login_headers_are_never_forwarded_upstream() {
+        let source = headers(&[
+            (LOGIN_EMAIL_HEADER, "a@b.test"),
+            (LOGIN_ID_HEADER, ID),
+            (LOGIN_PASSWORD_HEADER, "pw"),
+            ("content-type", "application/json"),
+        ]);
+        let mut forwarded = HeaderMap::new();
+        copy_safe_request_headers(&source, &mut forwarded);
+        assert!(forwarded.get(LOGIN_EMAIL_HEADER).is_none());
+        assert!(forwarded.get(LOGIN_ID_HEADER).is_none());
+        assert!(forwarded.get(LOGIN_PASSWORD_HEADER).is_none());
+        assert!(forwarded.get("content-type").is_some());
+    }
+
+    /// Loopback port 1 refuses at once, so every attestation (and so every login) fails fast.
+    fn unreachable_state() -> ProxyState {
+        let config = Config::new("127.0.0.1".into(), 0, "http://127.0.0.1:1".into())
+            .with_request_timeout_secs(5);
+        ProxyState::new(config)
+    }
+
+    fn login(email: &str, password: &str) -> LoginCredentials {
+        LoginCredentials {
+            ident: LoginIdent::Email(email.into()),
+            password: password.into(),
+        }
+    }
+
+    #[tokio::test]
+    async fn a_failed_login_leaves_no_slot_behind() {
+        let state = unreachable_state();
+        for n in 0..3 {
+            assert!(state.login_client(&login(&format!("{n}@b.test"), "pw")).await.is_err());
+        }
+        assert!(state.sessions.slots.lock().await.is_empty());
+    }
+
+    #[tokio::test]
+    async fn a_wrong_password_does_not_evict_a_working_session() {
+        let state = unreachable_state();
+        let cached = Arc::new(OpenSecretClient::new("http://127.0.0.1:1").unwrap());
+        let ident = LoginIdent::Email("a@b.test".into());
+        *state.sessions.slot(&ident).await.lock().await = Some(SessionEntry {
+            client: Arc::clone(&cached),
+            password: "right".into(),
+        });
+
+        assert!(state.login_client(&login("a@b.test", "wrong")).await.is_err());
+
+        let Ok(got) = state.login_client(&login("a@b.test", "right")).await else {
+            panic!("a wrong password evicted the working session");
+        };
+        assert!(Arc::ptr_eq(&got, &cached));
+        assert_eq!(state.sessions.slots.lock().await.len(), 1);
+    }
+
+    #[tokio::test]
+    async fn a_slot_another_request_holds_is_kept() {
+        let sessions = LoginSessions::default();
+        let ident = LoginIdent::Email("a@b.test".into());
+        let mine = sessions.slot(&ident).await;
+        let theirs = sessions.slot(&ident).await;
+        sessions.forget_if_unused(&ident, &mine).await;
+        assert_eq!(sessions.slots.lock().await.len(), 1, "another request still holds it");
+        drop(theirs);
+        sessions.forget_if_unused(&ident, &mine).await;
+        assert!(sessions.slots.lock().await.is_empty());
+    }
+
+    #[test]
+    fn the_default_client_id_is_the_published_maple_one() {
+        assert_eq!(
+            DEFAULT_LOGIN_CLIENT_ID.to_string(),
+            "ba5a14b5-d915-47b1-b7b1-afda52bc5fc6"
+        );
+    }
+}
